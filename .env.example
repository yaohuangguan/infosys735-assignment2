# AWS Academy Learner Lab temporary credentials
# Copy to .env and replace the three blank values.
# Get them from Learner Lab -> AWS Details -> AWS CLI.
# NEVER commit real keys or share them in chat/recordings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Project defaults
AWS_REGION=us-east-1
STACK_NAME=anygroupllc-a2
FORECAST_WAIT_SECONDS=90

# Optional SNS email recipient (requires email confirmation)
ALARM_EMAIL=

# Alternative: paste the entire AWS Academy AWS CLI block:
# [default]
# aws_access_key_id = ...
# aws_secret_access_key = ...
# aws_session_token = ...
# Remove the '#' if using these lines; keep only one set of credentials.
