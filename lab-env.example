# Learner Lab private credentials — save a copy as .env (NEVER commit .env)
# AWS Academy > Learner Lab > AWS Details > AWS CLI
# Paste your 3 short-lived values below:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Default project settings
AWS_REGION=us-east-1
STACK_NAME=anygroupllc-a2
FORECAST_WAIT_SECONDS=90

# Optional (must confirm the subscription by email):
ALARM_EMAIL=

# You may also paste the entire AWS Academy block here, unchanged:
# [default]
# aws_access_key_id = ...
# aws_secret_access_key = ...
# aws_session_token = ...
# If copied literally, remove "#" before the [default]/key lines.
